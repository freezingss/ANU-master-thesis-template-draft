@article{Liang1987,
    author = {Liang, Kung-Yee},
    title = {Estimating functions and approximate conditional likelihood},
    journal = {Biometrika},
    volume = {74},
    number = {4},
    pages = {695-702},
    year = {1987},
    month = {12},
    abstract = {The approximate conditional likelihood method proposed by Cox \&amp; Reid (1987) is applied to the estimation of a scalar parameter Θ, in the presence of nuisance parameters. The estimating function of Θ based on the approximate conditional likelihood is shown to be preferable to that based on the profile likelihood. A sufficient condition for both approaches to be equivalent is given. The role of parameter orthogonality is emphasized. Several examples including bivariate normal means with known coefficient of variation are presented.},
    issn = {0006-3444},
    doi = {10.1093/biomet/74.4.695},
    url = {https://doi.org/10.1093/biomet/74.4.695},
